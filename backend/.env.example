APP_ENV=local
# Dev stack: frontend on 3001 (scripts/dev-stack.sh)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DEFAULT_LLM_PROVIDER=gemini

# Platform metadata (M1) — sqlite for local; postgres recommended on CAI pilot
STATE_STORE=sqlite
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/accelerator
# DEFAULT_PROJECT_SLUG=tempo_scan_impala

# Document intelligence (M2A) — binary storage root (NFS mount in pilot)
DOCUMENT_STORAGE_ROOT=
DOCUMENT_MAX_FILE_MB=25
DOCUMENT_ALLOWED_TYPES=pdf,txt,docx,xlsx
DOCUMENT_CHUNK_SIZE=512
DOCUMENT_CHUNK_OVERLAP=64
EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=accelerator_chunks
# QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
DOCUMENT_AUTO_PROCESS=true
RETRIEVAL_TOP_K=20
RAG_SYSTEM_PROMPT_PATH=backend/prompts/rag_system.txt
RAG_CONVERSATION_TURNS=3
# RAG_DEFAULT_LIBRARY_IDS=
# RAG_MIN_RERANK_SCORE=0
RERANK_TOP_N=5
RAG_MAX_CONTEXT_TOKENS=4096
RERANKER_PROVIDER=none
# RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

QWEN_BASE_URL=
QWEN_API_TOKEN=
QWEN_MODEL=
QWEN_VERIFY_SSL=true

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alias also supported: MODEL_GEMINI=gemini-3.8-flash

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VERIFY_SSL=true

# M7A model registry secret refs (env://OPENAI_API_KEY, env://GEMINI_API_KEY, etc.)
ANTHROPIC_API_KEY=
# OpenAI-compatible (Cloudera AI Inference, vLLM, LiteLLM, Qwen gateway)
# QWEN_API_KEY=  # alias: use env://QWEN_API_KEY in provider secret_ref

# aws | ingram — reads labeled ### IMPALA CREDENTIALS … blocks from repo-root .env
IMPALA_CREDENTIAL_PROFILE=

IMPALA_HOST=localhost
IMPALA_PORT=21050
IMPALA_DATABASE=gold
IMPALA_AUTH_MECHANISM=GSSAPI
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_USE_SSL=true
IMPALA_USE_HTTP_TRANSPORT=false
IMPALA_HTTP_PATH=
IMPALA_KERBEROS_SERVICE_NAME=impala
IMPALA_QUERY_TIMEOUT_SECONDS=60
SQL_MAX_ROWS=200

# Optional last-resort fallback: a separately deployed, separately governed
# sibling system (see reference/tempo-agent-api). Only called when our own
# OSSIE planner can't match a published metric at all. Leave blank to
# disable - the fallback node is skipped entirely and behavior is
# unchanged from before this feature existed.
# tempo_agent_v3 on :9766 — see scripts/run-local-stack-governed.sh
# Leave empty for Phase C OSSIE-only (no tempo_agent_v3 sidecar).
LOCAL_AGENT_BASE_URL=http://127.0.0.1:9766
# auto = heuristics (DC/rank → v3, resolved OSSIE metric → ossie); ossie | v3 to force one path
ASK_DATA_ROUTING=auto

# Ask Data presentation tier (AMP) — global defaults; workspace can override via PUT /v1/ask-data/settings
ASK_DATA_PRESENTATION_TIER_ENABLED=true
# heuristic | always | never
ASK_DATA_PANEL_AUTO_OPEN=heuristic
ASK_DATA_TIER3_MIN_ROWS=13
ASK_DATA_TIER3_MIN_INSIGHTS=3
ASK_DATA_TIER3_MIN_IMPLICATIONS=2
ASK_DATA_RANK_TIER3_ABOVE_N=5
ASK_DATA_RANK_MIN_TIER=2
ASK_DATA_TIER1_MAX_ROWS=1
ASK_DATA_TIER1_MAX_COLUMNS=2
ASK_DATA_CHAT_DETAILS_DEFAULT_OPEN=false
# executive | analyst — chat copy and technical chrome
ASK_DATA_AUDIENCE_MODE=executive
# Legacy: when 1, same as ASK_DATA_ROUTING=v3
LOCAL_AGENT_PRIMARY=0
LOCAL_AGENT_TIMEOUT_SECONDS=180
# langgraph = faster KPI graph + judge; deep = coordinator subagent (demo only)
LOCAL_AGENT_ENGINE=langgraph
LOCAL_AGENT_MAX_ATTEMPTS=2
LOCAL_AGENT_RETRY_DELAY_SECONDS=2

# OSSIE answer judge loop (Phase B1)
JUDGE_ENABLED=true
JUDGE_MAX_ITERATIONS=2

# In-process TEMPO domain business graph (knowledge/tempo_domain_graph.yaml)
BUSINESS_GRAPH_ENABLED=true

# Phase C7 — optional PuppyGraph (entity scope only; off by default)
PUPPYGRAPH_ENABLED=false
PUPPYGRAPH_BASE_URL=

# MCP (Settings → MCP tab). Workspace JSON stores server defs only; secrets stay here.
# BRAVE_API_KEY=          # Brave Search preset (stdio npx @modelcontextprotocol/server-brave-search)
# Optional legacy env fallback when workspace has no MCP servers:
# MCP_CONNECTORS_JSON=[{"id":"studio-demo","name":"Studio Demo MCP","kind":"builtin"}]

# LLM usage telemetry (Usage page — SQLite at backend/runtime/llm_usage.sqlite)
USAGE_DB_PATH=
# Optional soft cap shown on frontend Usage tab (0 = hide budget bar)
USAGE_MONTHLY_TOKEN_BUDGET=0
