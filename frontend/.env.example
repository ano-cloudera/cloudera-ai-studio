NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8001
# Server-side proxy target for /api (must match backend port)
BACKEND_API_URL=http://127.0.0.1:8001
# Dev stack (scripts/run-dev-stack.sh): backend on 8001, web on 3001
NEXT_PUBLIC_ANALYSIS_REPORT_PANEL=true
# OSSIE-only (run-local-stack-ossie-only.sh):
NEXT_PUBLIC_AGENT_CHIP=Governed · Ossie + Impala
# Governed stack with tempo-agent-v3 (run-local-stack-governed.sh):
# NEXT_PUBLIC_AGENT_CHIP=Governed · tempo-agent-v3 + Impala
NEXT_PUBLIC_CHAT_STREAM_TIMEOUT_MS=180000
NEXT_PUBLIC_PRODUCT_NAME=Cloudera AI Studio
NEXT_PUBLIC_PRODUCT_SHORT_NAME=AI Studio
NEXT_PUBLIC_APP_NAME=Cloudera AI Studio
NEXT_PUBLIC_APP_SUBTITLE=AI Studio
NEXT_PUBLIC_PROJECT_NAME=Demo Project
# M1 capability flags (disabled features are omitted from nav — no placeholder pages)
NEXT_PUBLIC_FEATURE_ASK_DATA=true
NEXT_PUBLIC_FEATURE_USAGE=true
NEXT_PUBLIC_FEATURE_SETTINGS=true
NEXT_PUBLIC_FEATURE_DOCUMENTS=true
NEXT_PUBLIC_NAV_KNOWLEDGE=Knowledge
NEXT_PUBLIC_FEATURE_CONNECTORS=true
NEXT_PUBLIC_NAV_CONNECTORS=Data Sources
NEXT_PUBLIC_FEATURE_PROMPTS=true
NEXT_PUBLIC_FEATURE_SKILLS=true
NEXT_PUBLIC_FEATURE_SEMANTIC_LAYER=true
NEXT_PUBLIC_FEATURE_AI_MODEL_REGISTRY=true
# Optional override for sidebar/header primary name (defaults to app name when empty)
NEXT_PUBLIC_CUSTOMER_NAME=
NEXT_PUBLIC_APP_TAGLINE=AI Studio
NEXT_PUBLIC_SIDEBAR_POWERED_BY=Powered by Cloudera
NEXT_PUBLIC_SIDEBAR_FOOTER_CAPTION=Cloudera AI Studio
NEXT_PUBLIC_STARTER_QUESTIONS_CAPTION=Start with a question
NEXT_PUBLIC_NAV_USAGE=Usage
NEXT_PUBLIC_CHAT_PLACEHOLDER=Ask a question about your data…
NEXT_PUBLIC_EMPTY_STATE_TITLE=Ask your data a question
NEXT_PUBLIC_EMPTY_STATE_DESCRIPTION=Get a grounded answer, governed metrics, and a relevant visualization.
NEXT_PUBLIC_APP_LOGO=/Logo.png
NEXT_PUBLIC_EMPTY_STATE_LOGO=/Logo.png
