# Local CAI simulation — SQLite platform metadata (METADATA-001)
# Usage: set -a && source deployment/profiles/cai-sim-local.env && set +a

CAI_DATA_DIR=runtime/cai-sim
STATE_STORE=sqlite

# Empty DATABASE_URL → derived from CAI_DATA_DIR/metadata/studio.db via config.py
DATABASE_URL=

DOCUMENT_STORAGE_ROOT=documents
SEMANTIC_RUNTIME_STORAGE_ROOT=semantic

# RAG (local Qdrant)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=accelerator_chunks

FEATURE_PROFILE=FULL_ACCELERATOR
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Ask Data + Banking connector still use external PostgreSQL via Connector Manager / .env secrets
DATA_BACKEND=duckdb
DUCKDB_PATH=backend/runtime/tempo_gold_local.duckdb

# Single-process contract for SQLite metadata
UVICORN_WORKERS=1
