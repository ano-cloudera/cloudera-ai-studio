# Cloudera AI Studio — 3-App CAI deployment (NO SECRETS)
# Copy sections into CAI Application environment configuration.

# =============================================================================
# [BACKEND] Backend CAI Application
# =============================================================================
DEPLOYMENT_PROFILE=cai
FEATURE_PROFILE=FULL_ACCELERATOR
STATE_STORE=sqlite
UVICORN_WORKERS=1

# Persistent NFS mount (single root recommended)
CAI_DATA_DIR=/data/cai-studio

# Platform metadata — SQLite PoC on NFS (single backend / worker=1)
DATABASE_URL=sqlite+pysqlite:////data/cai-studio/metadata/studio.db

# Storage (absolute paths on NFS)
DOCUMENT_STORAGE_ROOT=/data/cai-studio/documents
SEMANTIC_RUNTIME_STORAGE_ROOT=/data/cai-studio/var/semantic-runtime

# Qdrant CAI Application (remote URL — not localhost in production)
QDRANT_URL=http://qdrant-service:6333
QDRANT_COLLECTION=accelerator_chunks
# QDRANT_API_KEY=          # SECRET — set in CAI secret store

# Browser CORS (Frontend public origin)
CORS_ORIGINS=https://cai-frontend.example.com

# Document ingestion
DOCUMENT_PDF_USE_PYPDF=true
DOCUMENT_AUTO_PROCESS=true

# RAG embeddings (generated in Backend — not by Qdrant)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_PROVIDER=none

# MCP — prefer workspace Settings (GET/PUT /api/v1/mcp/settings). Secrets on Backend only:
# BRAVE_API_KEY=            # SECRET — Brave Search stdio preset in Settings → MCP tab
# MCP_CONNECTORS_JSON=      # optional legacy fallback JSON when workspace servers empty

# LLM inference (at least one provider SECRET required for chat)
DEFAULT_LLM_PROVIDER=gemini
# GEMINI_API_KEY=           # SECRET
# OPENAI_API_KEY=           # SECRET
# QWEN_API_TOKEN=           # SECRET
GEMINI_MODEL=gemini-2.0-flash

# Ask Data legacy engine (optional; connectors preferred)
DATA_BACKEND=duckdb
DUCKDB_PATH=/data/cai-studio/var/askdata.duckdb

# Connector secret example (referenced as env:// in connector secret_ref)
# BANKING_DEMO_PG_PASSWORD=  # SECRET — customer datasource, not metadata DB

# =============================================================================
# [FRONTEND] Frontend CAI Application
# =============================================================================
# Server-side proxy to Backend service (internal URL)
BACKEND_API_URL=http://backend-service:8001
# Public URL users reach for API (if client calls backend directly)
NEXT_PUBLIC_BACKEND_URL=https://cai-backend.example.com
NEXT_PUBLIC_APP_NAME=Cloudera AI Studio
PORT=3000

# =============================================================================
# [QDRANT] Qdrant CAI Application
# =============================================================================
# Qdrant native config (image-specific); conceptual:
# QDRANT__STORAGE__STORAGE_PATH=/qdrant/storage
# Service port 6333
# Health: GET /healthz (verify on target Qdrant version in real CAI)
