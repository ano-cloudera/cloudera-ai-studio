# Copy to runtime-closure.env (local only — do not commit secrets).
# Sourced by scripts/run-dev-stack.sh when present.

STATE_STORE=postgres
DATABASE_URL=postgresql+psycopg://m1:REPLACE_PLATFORM_PASSWORD@127.0.0.1:55432/accelerator

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=accelerator_chunks
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=none
FEATURE_PROFILE=FULL_ACCELERATOR

# Business datasource (demo_sales — separate DB on same host)
DEV_POSTGRES_HOST=127.0.0.1
DEV_POSTGRES_PORT=55432
DEV_POSTGRES_DATABASE=demo_sales
DEV_POSTGRES_USER=demo_sales
DEMO_POSTGRES_PASSWORD=REPLACE_DEMO_SALES_PASSWORD
