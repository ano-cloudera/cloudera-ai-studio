# CAI Application — vLLM (OpenAI-compatible)
MODEL_PATH=/home/cdsw/models/<your-model>
GPU_PROFILE=h200
VLLM_MODEL=studio-llm
HF_HUB_OFFLINE=1
TENSOR_PARALLEL_SIZE=1
# VLLM_API_KEY=  # optional; set same on Backend OPENAI_API_KEY if used
STUDIO_REPO_ROOT=/home/cdsw/cloudera-ai-studio   # Application starts in /home/cdsw; no __file__ in the CAI kernel
APP_STARTUP_TIMEOUT_MINUTES=15
PYTHON_EXECUTABLE=/home/cdsw/.venvs/studio-vllm/bin/python
# Tuning (L40S: 0.82/8192/16; A10G 24GB: 0.92/4096/4; H200: 0.75/8192/32). Names VLLM_MAX_MODEL_LEN / VLLM_GPU_MEMORY_UTILIZATION are ignored.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=32
# Optional: tool calling (agents sending tool_choice=auto) and chat template fixes
# VLLM_TOOL_CALL_PARSER=qwen3_coder
# VLLM_CHAT_TEMPLATE=/home/cdsw/cloudera-ai-studio/config/vllm/<template>.jinja
# VLLM_USE_FLASHINFER_SAMPLER=0   # set automatically when nvcc is missing
