# CAI Application — Frontend
# Next.js rewrites are fixed at BUILD time: export BACKEND_API_URL (and any NEXT_PUBLIC_*) before `npm run build` in the Session.
# The browser only calls this Frontend (/api/...); Next proxies to the Backend, so the Backend needs no CORS for browsers.
BACKEND_API_URL=https://cai-studio-backend.<workspace-domain>
# Branding (build time): copy the values from config/examples/anywhere-branding.frontend.env
NEXT_PUBLIC_PRODUCT_NAME=Anywhere AI Studio
NEXT_PUBLIC_PRODUCT_SHORT_NAME=Anywhere AI Studio
NEXT_PUBLIC_APP_NAME=Anywhere AI Studio
NEXT_PUBLIC_APP_SUBTITLE=Anywhere AI Studio
NEXT_PUBLIC_APP_TAGLINE=Anywhere AI Studio
NEXT_PUBLIC_SIDEBAR_FOOTER_CAPTION=Anywhere AI Studio
NEXT_PUBLIC_SIDEBAR_POWERED_BY=Powered by Anywhere Cloud
NEXT_PUBLIC_PRODUCT_LOGO=/branding/anywhere-ai-logo.png
NEXT_PUBLIC_APP_LOGO=/branding/anywhere-ai-logo.png
NEXT_PUBLIC_EMPTY_STATE_LOGO=/branding/anywhere-ai-logo.png
CAI_SKIP_FRONTEND_BUILD=0
STUDIO_REPO_ROOT=/home/cdsw/anywhere-ai-studio   # Application starts in /home/cdsw; no __file__ in the CAI kernel
APP_STARTUP_TIMEOUT_MINUTES=15
NODE_HOME=/home/cdsw/tools/node   # install once: bash scripts/cai/prepare_node.sh
