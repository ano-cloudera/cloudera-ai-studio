# CAI Application — Frontend
BACKEND_API_URL=http://cai-studio-backend.<internal>:443
NEXT_PUBLIC_BACKEND_URL=https://cai-studio-backend.<your-domain>
NEXT_PUBLIC_APP_NAME=Cloudera AI Studio
CAI_SKIP_FRONTEND_BUILD=0
