# CAI Application — Qdrant (+ UI on readonly port when configured)
QDRANT_BINARY=/home/cdsw/tools/qdrant/qdrant
QDRANT_STORAGE_PATH=/home/cdsw/cai-studio-data/qdrant/storage
# Optional API key (must match Backend QDRANT_API_KEY if set)
# QDRANT_API_KEY=
# Official Web UI: served at <app-url>/dashboard (install once: bash scripts/cai/prepare_qdrant_ui.sh)
QDRANT_STATIC_DIR=/home/cdsw/tools/qdrant/static
# CDSW_READONLY_PORT is no longer needed (legacy minimal HTML UI fallback only)
STUDIO_REPO_ROOT=/home/cdsw/cloudera-ai-studio   # Application starts in /home/cdsw; no __file__ in the CAI kernel
APP_STARTUP_TIMEOUT_MINUTES=5
