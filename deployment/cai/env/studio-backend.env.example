# CAI Application — Backend (copy into CAI env UI; add secrets separately)
CAI_ENV_FILE=/home/cdsw/cloudera-ai-studio/deployment/profiles/cai.env
DEPLOYMENT_PROFILE=cai
STATE_STORE=sqlite
UVICORN_WORKERS=1
CAI_DATA_DIR=/data/cai-studio
DATABASE_URL=sqlite+pysqlite:////data/cai-studio/metadata/studio.db
DOCUMENT_STORAGE_ROOT=/data/cai-studio/documents
SEMANTIC_RUNTIME_STORAGE_ROOT=/data/cai-studio/var/semantic-runtime
QDRANT_URL=http://cai-studio-qdrant.<your-domain>:443
QDRANT_COLLECTION=accelerator_chunks
CORS_ORIGINS=https://cai-studio-frontend.<your-domain>
EMBEDDING_PROVIDER=bge_m3
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_BASE=https://cai-studio-vllm.<your-domain>/v1
OPENAI_API_KEY=local-vllm-key
OPENAI_MODEL=studio-llm
# MCP connectors JSON (one line) — or use default studio-demo builtin
# MCP_CONNECTORS_JSON=[{"id":"studio-demo","name":"Studio Demo MCP","kind":"builtin"}]
