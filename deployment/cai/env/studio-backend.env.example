# CAI Application — Backend (copy into CAI env UI; add secrets separately)
# Settings load only environment variables here (no .env on CAI); deployment/profiles/cai.env is not read.
DEPLOYMENT_PROFILE=cai
STATE_STORE=sqlite
UVICORN_WORKERS=1
CAI_DATA_DIR=/home/cdsw/cai-studio-data
DATABASE_URL=sqlite+pysqlite:////home/cdsw/cai-studio-data/metadata/studio.db
DOCUMENT_STORAGE_ROOT=/home/cdsw/cai-studio-data/documents
SEMANTIC_RUNTIME_STORAGE_ROOT=/home/cdsw/cai-studio-data/var/semantic-runtime
QDRANT_URL=https://cai-studio-qdrant.<workspace-domain>:443   # keep :443 — qdrant-client falls back to port 6333 when the URL has no port; no pod IP (it changes every start)
QDRANT_COLLECTION=accelerator_chunks
CORS_ORIGINS=https://cai-studio-frontend.<your-domain>
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=/home/cdsw/models/bge-m3
HF_HUB_OFFLINE=1
# LLM: choose provider/model in the UI (Settings -> AI Models, then assign capabilities). Do NOT set DEFAULT_LLM_PROVIDER here.
# The UI only stores a pointer such as env://GEMINI_API_KEY, so set just the key(s) you may use, as CAI secrets:
# GEMINI_API_KEY=      # SECRET
# OPENAI_API_KEY=      # SECRET
# ANTHROPIC_API_KEY=   # SECRET (adding a new key later needs an Application restart)
# MCP connectors JSON (one line) — or use default studio-demo builtin
# MCP_CONNECTORS_JSON=[{"id":"studio-demo","name":"Studio Demo MCP","kind":"builtin"}]
STUDIO_REPO_ROOT=/home/cdsw/cloudera-ai-studio   # Application starts in /home/cdsw; no __file__ in the CAI kernel
APP_STARTUP_TIMEOUT_MINUTES=10
PYTHON_EXECUTABLE=/home/cdsw/.venvs/studio-backend/bin/python

# Optional: load secrets from Infisical at start (see deployment/cai/infisical.py). Keep ONLY these on the Application;
# put GEMINI_API_KEY, TRINO_PASSWORD, etc. in Infisical instead. Off unless the four required values are set.
# INFISICAL_URL=https://<your-infisical>
# INFISICAL_CLIENT_ID=            # SECRET (Machine Identity, Universal Auth)
# INFISICAL_CLIENT_SECRET=        # SECRET
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod              # environment slug
# INFISICAL_SECRET_PATH=/         # folder
# INFISICAL_OVERRIDE=0            # 1 = Infisical replaces variables already set here
# INFISICAL_REQUIRED=0            # 1 = refuse to start when Infisical cannot be read
