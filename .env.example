# ============================================================
# Application (Backend)
# ============================================================
APP_ENV=local
PROJECT_ID=tempo_scan_impala

# M1 platform metadata (backend): sqlite local default; postgres on CAI pilot
STATE_STORE=sqlite
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/accelerator
# DEFAULT_PROJECT_SLUG=tempo_scan_impala

# Split deployment (Milestone 7.2): set this to the deployed "Tempo Scan
# Frontend" CAI Application's public URL, comma-separated if there is more
# than one (e.g. a preview + production URL). No wildcard in production.
# Legacy single-app path (scripts/run-cai-app.sh): localhost values below
# are enough since frontend and backend share an origin.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ============================================================
# LLM (Qwen / vLLM — proven serving endpoint, consumed via env only)
# ============================================================
# mock: deterministic offline responses, no network calls (default, safe for CAI first deploy)
# remote: calls the OpenAI-compatible Qwen endpoint below
LLM_MODE=mock
QWEN_BASE_URL=https://qwen-model.ml-1ac6654a-4de.ano03-cd.a465-9q4k.cloudera.site/v1
QWEN_MODEL=Qwen3.8-27B-AWQ
QWEN_API_TOKEN=
QWEN_REQUEST_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=1
QWEN_VERIFY_SSL=true
QWEN_DISABLE_THINKING=true
QWEN_MAX_TOKENS=1400

# Optional: route LLM calls through the LiteLLM proxy Application
# (litellm/config.yaml) instead of calling Qwen directly. Leave
# LITELLM_BASE_URL empty to keep calling Qwen directly (default, backward
# compatible with deployments that haven't stood up the LiteLLM
# Application). Once set, the QWEN_* variables above are still required —
# they configure the "commercial-intelligence" model group inside
# litellm/config.yaml itself, since the LiteLLM Application reads them from
# its own environment, not from this backend's.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL_GROUP=commercial-intelligence
# The planned Cloudera Agent Studio workflow, added as an additional
# LiteLLM model group once provisioned. Leave false until then — the
# backend keeps calling the proven commercial-intelligence group either
# way, and LiteLLM itself falls back automatically if this is turned on
# before Agent Studio is reachable (the user is told when that happens).
LITELLM_AGENT_STUDIO_MODEL_GROUP=agent-studio-workflow
LITELLM_USE_AGENT_STUDIO=false

# Selects run_chat()'s implementation (app/services/chat.py). "graph" (the
# default) keeps the existing LangGraph workflow. "agent_studio" calls the
# deployed Agent Studio workflow's REST API directly (createSession ->
# kickoff -> poll events) and adapts its Markdown answer into ChatResponse
# — separate from LITELLM_USE_AGENT_STUDIO above, which only swaps which
# LiteLLM model group backs LLM calls inside the existing graph, not which
# code path answers the request.
CHAT_BACKEND=graph
# Base URL of the deployed Agent Studio workflow, e.g.
# https://workflow-<id>.ml-<workspace>.<domain>.cloudera.site — required
# when CHAT_BACKEND=agent_studio.
AGENT_STUDIO_BASE_URL=
# Cloudera AI API v2 key (same one available as $CDSW_APIV2_KEY in a CAI
# session) used as the Bearer token against Agent Studio's REST API.
AGENT_STUDIO_API_KEY=
AGENT_STUDIO_POLL_TIMEOUT_SECONDS=90
AGENT_STUDIO_POLL_INTERVAL_SECONDS=2

# ============================================================
# Data Backend
# ============================================================
# impala: governed TEMPO Q4 2024 real data via Apache Ossie (default) —
# requires the IMPALA_* credentials below.
# duckdb: local governed development — gold.* sample in DUCKDB_PATH (see
# docs/local-governed-dev.md, backend/scripts/seed_local_gold_duckdb.py).
# Use when Impala/Ingram is unavailable; sample numbers are not production KPIs.
# (Legacy forecast/weather tools also use DuckDB via DUCKDB_PATH when configured.)
# trino: alternate live CDW connection (kept for the trino data backend
# tests; not exercised by the OSSIE path).
DATA_BACKEND=impala
DUCKDB_PATH=runtime/tempo_scan.duckdb

# semantic_execution_mode is effectively always "ossie" now - the legacy
# DuckDB-synthetic semantic/SQL-generation pipeline was removed from the
# Ask AI request path. "legacy" only still means anything for the
# retained-but-routing-disconnected forecast/weather/market nodes' own
# tests/tooling; it does not restore the old Ask AI chat behavior.
SEMANTIC_EXECUTION_MODE=ossie
OSSIE_PROJECT_ID=tempo_scan_impala
OSSIE_MAX_ROWS=200

IMPALA_HOST=localhost
IMPALA_PORT=21050
IMPALA_DATABASE=gold
IMPALA_AUTH_MECHANISM=PLAIN
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_USE_SSL=false
# Only needed for a gateway-fronted coordinator (e.g. a CDP Impala Virtual
# Warehouse reached over HTTPS/443 rather than a direct Thrift port). Leave
# both unset/false for a direct-coordinator setup on the binary protocol.
IMPALA_USE_HTTP_TRANSPORT=false
IMPALA_HTTP_PATH=

TRINO_JDBC_URL=jdbc:trino://ano03-trino-demo.dw-ano03-cdp-env.a465-9q4k.cloudera.site:443
TRINO_HOST=
TRINO_PORT=443
TRINO_HTTP_SCHEME=https
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_USER=
TRINO_PASSWORD=
TRINO_ACCESS_TOKEN=
TRINO_VERIFY_SSL=true
TRINO_CONNECT_TIMEOUT_SECONDS=10
TRINO_QUERY_TIMEOUT_SECONDS=60
TRINO_MAX_ROWS=500

# Dedicated bootstrap identity. Never reuse the application TRINO_* credential.
TRINO_LOADER_JDBC_URL=jdbc:trino://ano03-trino-demo.dw-ano03-cdp-env.a465-9q4k.cloudera.site:443
TRINO_LOADER_HOST=
TRINO_LOADER_PORT=443
TRINO_LOADER_HTTP_SCHEME=https
TRINO_LOADER_CATALOG=
TRINO_LOADER_SCHEMA=
TRINO_LOADER_USER=
TRINO_LOADER_PASSWORD=
TRINO_LOADER_ACCESS_TOKEN=
TRINO_LOADER_VERIFY_SSL=true
TRINO_LOADER_CONNECT_TIMEOUT_SECONDS=10
TRINO_LOADER_QUERY_TIMEOUT_SECONDS=120
TRINO_LOADER_BATCH_SIZE=500
TRINO_LOADER_DRY_RUN=false

SQL_MAX_ROWS=500
SQL_MAX_REPAIR_ATTEMPTS=1

# Optional: DetectJailbreak (input) + SecretsPresent (output) validators
# from Guardrails Hub, layered on top of the always-on deterministic
# checks. When GUARDRAILS_ENABLED=true on a CAI Application,
# app_cai_backend.py automatically installs guardrails-ai and both
# validators on first startup using GUARDRAILS_TOKEN (a Guardrails Hub API
# key from guardrailsai.com) - set that as a CAI secret, never commit it.
# Leave GUARDRAILS_ENABLED=false to skip this entirely (default) - the app
# runs with deterministic-only checks either way, this never blocks startup.
GUARDRAILS_ENABLED=false
GUARDRAILS_TOKEN=
TELEMETRY_DB_PATH=runtime/telemetry.sqlite

# ============================================================
# Mock External Market API (internal, governed snapshot-backed)
# ============================================================
MARKET_API_BASE_URL=http://127.0.0.1:8100

# ============================================================
# Optional External Refresh (data-refresh only, not a runtime dependency)
# ============================================================
# Serper.dev is a controlled snapshot-refresh mechanism run manually/offline
# (see scripts/fetch_market_snapshot.py). Leave SERPER_ENABLED=false for
# normal application startup — the app reads persisted snapshots instead.
SERPER_API_KEY=
SERPER_ENABLED=false
SERPER_MAX_QUERIES=5
# Legacy alias kept during migration; prefer SERPER_API_KEY.
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
SERPAPI_MAX_QUERIES=5

# ============================================================
# Frontend (public-safe only — inlined into the browser bundle at build
# time, NEVER put secrets here: no Qwen token, no Serper key, no Trino
# credentials, no database credentials)
# ============================================================
# Split deployment (Milestone 7.2): the deployed "Tempo Scan Backend" CAI
# Application's public URL. Required by scripts/run-cai-frontend.sh.
# Leave unset for the legacy single-app path (scripts/run-cai-app.sh),
# where the frontend calls the backend same-origin via /api/*.
NEXT_PUBLIC_BACKEND_API_URL=
NEXT_PUBLIC_APP_NAME=Commercial Intelligence
NEXT_PUBLIC_CUSTOMER_NAME=Tempo Scan
