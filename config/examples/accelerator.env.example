# Cloudera AI Accelerator — environment template (no secrets)
# Copy to repo root: cp config/examples/accelerator.env.example .env

# --- PLATFORM ---
APP_NAME="Cloudera AI Accelerator"
APP_ENV=local
ACCELERATOR_VERSION=1.0.0-m6
DEPLOYMENT_PROFILE=local
FEATURE_PROFILE=FULL_ACCELERATOR
STATE_STORE=postgres
DEFAULT_PROJECT_SLUG=tempo_scan_impala
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- DATABASE (platform metadata only — NOT business datasource) ---
DATABASE_URL=postgresql+psycopg://accelerator:accelerator@127.0.0.1:5432/accelerator

# --- DOCUMENT STORAGE ---
DOCUMENT_STORAGE_ROOT=backend/runtime/document_storage

# --- SEMANTIC RUNTIME ARTIFACTS ---
SEMANTIC_RUNTIME_STORAGE_ROOT=backend/var/semantic-runtime
SEMANTIC_DEFAULT_MODEL_KEY=example_core

# --- QDRANT (RAG; optional for Ask Data-only) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=accelerator_chunks
# QDRANT_API_KEY=

# --- LLM ---
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
QWEN_BASE_URL=
QWEN_API_TOKEN=
OPENAI_API_KEY=

# --- EMBEDDING / RERANK (RAG) ---
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_PROVIDER=none

# --- ASK DATA LEGACY DATASOURCE (optional if using connectors) ---
DATA_BACKEND=duckdb
DUCKDB_PATH=backend/runtime/tempo_gold_local.duckdb
OSSIE_PROJECT_ID=tempo_scan_impala

# --- CONNECTORS (optional; configure in UI or bootstrap seeds) ---
# Business datasources use Connector Manager — never DATABASE_URL above.

# --- FRONTEND (build-time for Next.js) ---
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8001
NEXT_PUBLIC_APP_NAME="Cloudera AI Accelerator"
NEXT_PUBLIC_FEATURE_ASK_DATA=true
NEXT_PUBLIC_FEATURE_DOCUMENTS=true
NEXT_PUBLIC_FEATURE_PROMPTS=true
NEXT_PUBLIC_FEATURE_SKILLS=true
NEXT_PUBLIC_FEATURE_SEMANTIC_LAYER=true
NEXT_PUBLIC_FEATURE_CONNECTORS=true
NEXT_PUBLIC_FEATURE_USAGE=true
